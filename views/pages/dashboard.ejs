<!-- Mostrar listado de Superhéroes-->
<table class="table table-dark table-hover text-center align-middle shadow">
  <thead>
    <tr>
      <th>Nombre</th>
      <th>Edad</th>
      <th>Acciones</th>
    </tr>
  </thead>

  <tbody>
    <% heroes.forEach(hero => { %>
    <tr>
      <td><%= hero.nombreSuperHeroe %></td>
      <td><%= hero.edad %></td>
      <td>
        <a class="btn btn-info btn-sm" href="/heroes/perfil/<%= hero._id %>">Ver</a>
        <a class="btn btn-warning btn-sm" href="/heroes/editar/<%= hero._id %>">Editar</a>
        <form action="/heroes/eliminar/<%= hero._id %>?_method=DELETE" method="POST"     style="display:inline;" onsubmit="return confirmarEliminacion(event)">
         <button class="btn btn-danger btn-sm">Eliminar</button>
        </form>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>