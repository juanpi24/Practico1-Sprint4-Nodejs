<!-- Mostrar Vista Contactos-->
<div class="text-center mb-5">
  <h1 class="fw-bold">Contacto</h1>
  <p class="text-muted">¿Tenés dudas o sugerencias? Escribinos</p>
</div>

<div class="row">

  <!-- FORM -->
  <div class="col-md-6">

    <form>

      <div class="mb-3">
        <label class="form-label">Nombre</label>
        <input type="text" class="form-control" placeholder="Tu nombre">
      </div>

      <div class="mb-3">
        <label class="form-label">Email</label>
        <input type="email" class="form-control" placeholder="tu@email.com">
      </div>

      <div class="mb-3">
        <label class="form-label">Mensaje</label>
        <textarea class="form-control" rows="4" placeholder="Escribí tu mensaje..."></textarea>
      </div>

      <button class="btn btn-primary">
        <i class="bi bi-send-fill me-1"></i> Enviar
      </button>

    </form>

  </div>

  <!-- INFO -->
  <div class="col-md-6">

    <div class="card shadow-sm p-4 mb-3">
      <h5><i class="bi bi-geo-alt-fill me-2"></i> Ubicación</h5>
      <p>La Rioja, Argentina</p>
    </div>

    <div class="card shadow-sm p-4 mb-3">
      <h5><i class="bi bi-envelope-fill me-2"></i> Email</h5>
      <p>contacto@superapp.com</p>
    </div>

    <div class="card shadow-sm p-4">
      <h5><i class="bi bi-telephone-fill me-2"></i> Teléfono</h5>
      <p>+54 380 1234567</p>
    </div>

  </div>

</div>

<hr class="my-5">